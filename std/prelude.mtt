prelude

-- The mtt standard prelude. Brought into scope by the `prelude` keyword;
-- everything here is axiom-free (definable from the core). Because it is
-- ordinary mtt, this file doubles as the reference for how the basics are
-- built.

-- === Data ===

-- the unit type: a record (single constructor, no fields), so it has
-- definitional η — any two elements are equal. The `@[notation unit]` attribute
-- registers it as the type whose constructor `()` abbreviates (and which the
-- printer renders back as `()`).
@[notation unit]
inductive Unit : Type :=
| unit : Unit

-- === Functions ===

def id (A : Type) (x : A) : A := x

def comp (A B C : Type) (g : B → C) (f : A → B) (x : A) : C := g (f x)

-- === Pairs ===

-- the dependent pair (Σ-type): a record (single constructor, no recursive
-- fields), so it has definitional η and the positional projections .1/.2. The
-- `@[notation sigma]` attribute registers it as the type the `Σ`/`×` formers
-- and `(a, b)` tuples abbreviate; `B` is a family over `A`, and a non-dependent
-- `A × B` is `Sigma A (fun _ => B)`. Fixed at `Type` (a universe-polymorphic
-- Σ that lands at the max of its components awaits universe polymorphism).
@[notation sigma]
inductive Sigma (A : Type) (B : A → Type) : Type :=
| mk : (a : A) → B a → Sigma A B

-- the binary sum (coproduct). `@[notation sum]` registers it for the infix `+`
-- former; its injections and eliminator are the ordinary qualified names
-- `Sum.inl`/`Sum.inr`/`Sum.rec` (like every other inductive). Like `Sigma`,
-- fixed at `Type`; a proof-irrelevant disjunction `Or : Prop` awaits universe
-- polymorphism.
@[notation sum]
inductive Sum (A B : Type) : Type :=
| inl : A → Sum A B
| inr : B → Sum A B

-- === Logic ===

-- falsity: an inductive with no constructors. Empty.rec is ex falso — with no
-- minor premises it eliminates a proof of Empty into any motive (subsingleton
-- elimination, sound because there are no introduction forms)
inductive Empty : Prop

-- ex falso quodlibet: from a proof of Empty, anything follows. Fixed at Type
-- (so it also covers Prop by cumulativity); a universe-polymorphic version
-- awaits universe polymorphism
def absurd (A : Type) (h : Empty) : A := Empty.rec _ h

-- negation; by the imax rule A → Empty is a proposition for any A, so `not`
-- applies to data as well as propositions
def not (A : Type) := A → Empty

-- === Equality ===

-- propositional equality as an indexed inductive family: the first endpoint is
-- a parameter, the second an index, and the sole constructor `rfl` proves
-- `Eq A x x`. Its recursor `Eq.rec` is based path induction (the motive abstracts
-- the second endpoint, the first fixed) — the equivalent of Lean's `Eq.rec`. The
-- surface forms `x = y` and `refl` are sugar for the former and constructor; the
-- eliminator is written out as `Eq.rec` (there is no `J` keyword). It is the last
-- builtin retired into the prelude — the kernel now knows only Sort/Π/λ/App/Var
-- and the generic inductive machinery.
@[notation eq]
inductive Eq (A : Type) (x : A) : A -> Prop :=
| rfl : Eq A x x

-- equality is symmetric: if `a = b` then `b = a`.
def symm {A : Type} {x y : A} (p : x = y) : y = x :=
  Eq.rec _ _ (λ z : A ⇒ λ q : x = z ⇒ z = x) refl _ p

-- equality is transitive: if `a = b` and `b = c` then `a = c`.
def trans {A : Type} {x y z : A} (p : x = y) (q : y = z) : x = z :=
  Eq.rec _ _ (λ w : A ⇒ λ r : y = w ⇒ x = w) p _ q

-- transport along an equality (large elimination: the motive lands in Type).
-- Transparent (a `def`) so transport along `refl` computes away (ι). The types
-- and endpoints are implicit.
def subst {A : Type} (P : A → Type) {x y : A} (p : x = y) (h : P x) : P y :=
  Eq.rec _ _ (λ z : A ⇒ λ q : x = z ⇒ P z) h _ p

-- congruence: equal arguments give equal images. The types and endpoints are
-- implicit ({…}) — recovered from the equality proof — so a call is just
-- `cong f p`.
def cong {A B : Type} (f : A → B) {x y : A} (p : x = y) : f x = f y :=
  Eq.rec _ _ (λ z : A ⇒ λ q : x = z ⇒ f x = f z) refl _ p

-- === Naturals === (arithmetic by recursion on the first argument)

-- the naturals: an ordinary inductive. `@[notation nat]` registers it as the
-- type whose constructors decimal literals abbreviate (`0`, `2`, …) and which
-- the printer folds succ-chains back into; `Nat.succ`/`Nat.zero`/`Nat.rec` are
-- the qualified constructor and recursor names.
@[notation nat]
inductive Nat : Type :=
| zero : Nat
| succ : Nat → Nat

def add (m n : Nat) : Nat :=
  Nat.rec _ n (λ k : Nat ⇒ λ ih : Nat ⇒ Nat.succ ih) m

def mul (m n : Nat) : Nat :=
  Nat.rec _ 0 (λ k : Nat ⇒ λ ih : Nat ⇒ add n ih) m

def pred (n : Nat) : Nat :=
  Nat.rec _ 0 (λ k : Nat ⇒ λ ih : Nat ⇒ k) n

-- foundational lemmas. add recurses on its first argument, so add 0 n reduces
-- to n (zero_add is refl) but add n 0 is stuck on n and needs induction.
theorem zero_add (n : Nat) : add 0 n = n := refl

theorem add_zero (n : Nat) : add n 0 = n :=
  Nat.rec _
    refl
    (λ k : Nat ⇒ λ ih : add k 0 = k ⇒
      cong (λ m : Nat ⇒ Nat.succ m) ih)
    n

theorem add_succ (n m : Nat) : add n (Nat.succ m) = Nat.succ (add n m) :=
  Nat.rec _
    refl
    (λ k : Nat ⇒ λ ih : add k (Nat.succ m) = Nat.succ (add k m) ⇒
      cong (λ z : Nat ⇒ Nat.succ z) ih)
    n

theorem add_comm (m n : Nat) : add m n = add n m :=
  Nat.rec _
    (symm (add_zero n))
    (λ k : Nat ⇒ λ ih : add k n = add n k ⇒
      trans (cong (λ z : Nat ⇒ Nat.succ z) ih) (symm (add_succ n k)))
    m
