prelude

-- The mtt standard prelude: small, axiom-free definitions (data, logic,
-- equality, arithmetic) loaded automatically into every file and REPL session.
-- Being ordinary mtt, it also doubles as a reference for how the basics look.

-- `True` is a proposition with a single introduction rule.
-- In other words, `True` is just true.
inductive True : Prop :=
| intro : True

-- `False` is the empty proposition, with no introduction rules.
-- It represents a contradiction.
inductive False : Prop

-- `Not p` is the negation of `p`, defined as `p → False`.
-- It holds exactly when `p` is unprovable.
def Not (p : Prop) : Prop := p → False

-- Anything follows from a contradiction.
def absurd {a : Prop} {b : Sort v} (h1 : a) (h2 : Not a) : b := False.rec _ (h2 h1)


-- Propositional equality. The infix `x = y` is notation for `Eq`; `rfl` (below)
-- proves reflexivity and `Eq.rec` is the eliminator.
@[notation eq]
inductive Eq (A : Sort u) (x : A) : A -> Prop :=
| refl : Eq A x x

-- reflexivity: `rfl : x = x`. The type and endpoint are implicit, so it proves
-- any goal of the form `a = a`.
def rfl {A : Sort u} {x : A} : x = x := Eq.refl A x

-- symmetry: if `x = y` then `y = x`.
def symm {A : Sort u} {x y : A} (p : x = y) : y = x :=
  Eq.rec _ _ (λ z : A ⇒ λ q : x = z ⇒ z = x) rfl _ p

-- transitivity: if `x = y` and `y = z` then `x = z`.
def trans {A : Sort u} {x y z : A} (p : x = y) (q : y = z) : x = z :=
  Eq.rec _ _ (λ w : A ⇒ λ r : y = w ⇒ x = w) p _ q

-- transport: given `x = y`, rewrite a proof of `P x` into a proof of `P y`.
def subst {A : Sort u} (P : A → Sort v) {x y : A} (p : x = y) (h : P x) : P y :=
  Eq.rec _ _ (λ z : A ⇒ λ q : x = z ⇒ P z) h _ p

-- congruence: from `p : x = y`, `cong f p : f x = f y`.
def cong {A : Sort u} {B : Sort v} (f : A → B) {x y : A} (p : x = y) : f x = f y :=
  Eq.rec _ _ (λ z : A ⇒ λ q : x = z ⇒ f x = f z) rfl _ p

-- === Functions ===

-- The identity function.
def id {A : Sort u} (x : A) : A := x

-- Function composition: `comp g f` applies `f`, then `g`.
def comp {A : Sort u} {B : Sort v} {C : Sort w} (g : B → C) (f : A → B) (x : A) : C := g (f x)


-- The dependent pair: `(a, b)` is a pair and `p.1`/`p.2` its projections. The
-- type is `Σ (x : A) ⇒ B` with `B` a family over `A`, or `A × B` when `B` does
-- not depend on `A`. It works at any universe, so it can also pair proofs.
@[notation sigma]
inductive Sigma (A : Sort u) (B : A → Sort v) : Sort (max u v) :=
| mk : (fst : A) → (snd : B fst) → Sigma A B

-- The binary sum `A + B`: inject with `Sum.inl`/`Sum.inr`, eliminate with
-- `Sum.rec`. It works for propositions too (a disjunction), not just data.
@[notation sum]
inductive Sum (A : Sort u) (B : Sort v) : Sort (max u v) :=
| inl : A → Sum A B
| inr : B → Sum A B


-- The empty type. It has no constructors.
inductive Empty : Prop

-- The canonical type with just one element: a single element `()`.
-- Any two elements are equal.
@[notation unit]
inductive Unit : Type :=
| unit : Unit

-- The natural numbers. Decimal literals (`0`, `1`, `2`, …) are notation for
-- `Nat.zero`/`Nat.succ`; eliminate with `Nat.rec`.
@[notation nat]
inductive Nat : Type :=
| zero : Nat
| succ : Nat → Nat

-- addition, by recursion on the first argument.
def add (m n : Nat) : Nat :=
  Nat.rec _ n (λ k : Nat ⇒ λ ih : Nat ⇒ Nat.succ ih) m

-- multiplication.
def mul (m n : Nat) : Nat :=
  Nat.rec _ 0 (λ k : Nat ⇒ λ ih : Nat ⇒ add n ih) m

-- predecessor, with `pred 0 = 0`.
def pred (n : Nat) : Nat :=
  Nat.rec _ 0 (λ k : Nat ⇒ λ ih : Nat ⇒ k) n

-- `0 + n = n`. Holds by `rfl`, since `add` recurses on its first argument.
theorem zero_add (n : Nat) : add 0 n = n := rfl

-- `n + 0 = n`. The mirror of `zero_add`, but needs induction on `n`.
theorem add_zero (n : Nat) : add n 0 = n :=
  Nat.rec _
    rfl
    (λ k : Nat ⇒ λ ih : add k 0 = k ⇒
      cong (λ m : Nat ⇒ Nat.succ m) ih)
    n

-- `n + (m + 1) = (n + m) + 1`: addition commutes with `succ` on the right.
theorem add_succ (n m : Nat) : add n (Nat.succ m) = Nat.succ (add n m) :=
  Nat.rec _
    rfl
    (λ k : Nat ⇒ λ ih : add k (Nat.succ m) = Nat.succ (add k m) ⇒
      cong (λ z : Nat ⇒ Nat.succ z) ih)
    n

-- addition is commutative.
theorem add_comm (m n : Nat) : add m n = add n m :=
  Nat.rec _
    (symm (add_zero n))
    (λ k : Nat ⇒ λ ih : add k n = add n k ⇒
      trans (cong (λ z : Nat ⇒ Nat.succ z) ih) (symm (add_succ n k)))
    m
