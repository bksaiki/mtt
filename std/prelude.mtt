prelude

-- The mtt standard prelude. Brought into scope by the `prelude` keyword;
-- everything here is axiom-free (definable from the core). Because it is
-- ordinary mtt, this file doubles as the reference for how the basics are
-- built.

-- === Data ===

-- the unit type: a record (single constructor, no fields), so it has
-- definitional η — any two elements are equal. The `@[notation unit]` attribute
-- registers it as the type whose constructor `()` abbreviates (and which the
-- printer renders back as `()`).
@[notation unit]
inductive Unit : Type :=
| unit : Unit

-- === Functions ===

def id (A : Type) (x : A) : A := x

def comp (A B C : Type) (g : B → C) (f : A → B) (x : A) : C := g (f x)

-- === Logic ===

-- falsity: an inductive with no constructors. Empty.rec is ex falso — with no
-- minor premises it eliminates a proof of Empty into any motive (subsingleton
-- elimination, sound because there are no introduction forms)
inductive Empty : Prop

-- ex falso quodlibet: from a proof of Empty, anything follows. Fixed at Type
-- (so it also covers Prop by cumulativity); a universe-polymorphic version
-- awaits universe polymorphism
def absurd (A : Type) (h : Empty) : A := Empty.rec (fun (_ : Empty) => A) h

-- negation; by the imax rule A → Empty is a proposition for any A, so `not`
-- applies to data as well as propositions
def not (A : Type) := A → Empty

-- === Equality === (each lemma is one J at a chosen motive)

-- congruence: equal arguments give equal images
def cong (A B : Type) (f : A → B) (x y : A) (p : Eq A x y) : Eq B (f x) (f y) :=
  J (λ z : A ⇒ λ q : Eq A x z ⇒ Eq B (f x) (f z)) refl p

def sym (A : Type) (x y : A) (p : Eq A x y) : Eq A y x :=
  J (λ z : A ⇒ λ q : Eq A x z ⇒ Eq A z x) refl p

def trans (A : Type) (x y z : A) (p : Eq A x y) (q : Eq A y z) : Eq A x z :=
  J (λ w : A ⇒ λ r : Eq A y w ⇒ Eq A x w) p q

-- transport along an equality (large elimination: the motive lands in Type)
def subst (A : Type) (P : A → Type) (x y : A) (p : Eq A x y) (h : P x) : P y :=
  J (λ z : A ⇒ λ q : Eq A x z ⇒ P z) h p

-- === Naturals === (arithmetic by recursion on the first argument)

-- the naturals: an ordinary inductive. `@[notation nat]` registers it as the
-- type whose constructors decimal literals abbreviate (`0`, `2`, …) and which
-- the printer folds succ-chains back into; `Nat.succ`/`Nat.zero`/`Nat.rec` are
-- the qualified constructor and recursor names.
@[notation nat]
inductive Nat : Type :=
| zero : Nat
| succ : Nat → Nat

def add (m n : Nat) : Nat :=
  Nat.rec (λ x : Nat ⇒ Nat) n (λ k : Nat ⇒ λ ih : Nat ⇒ Nat.succ ih) m

def mul (m n : Nat) : Nat :=
  Nat.rec (λ x : Nat ⇒ Nat) 0 (λ k : Nat ⇒ λ ih : Nat ⇒ add n ih) m

def pred (n : Nat) : Nat :=
  Nat.rec (λ x : Nat ⇒ Nat) 0 (λ k : Nat ⇒ λ ih : Nat ⇒ k) n

-- foundational lemmas. add recurses on its first argument, so add 0 n reduces
-- to n (zero_add is refl) but add n 0 is stuck on n and needs induction.
theorem zero_add (n : Nat) : Eq Nat (add 0 n) n := refl

theorem add_zero (n : Nat) : Eq Nat (add n 0) n :=
  Nat.rec (λ m : Nat ⇒ Eq Nat (add m 0) m)
    refl
    (λ k : Nat ⇒ λ ih : Eq Nat (add k 0) k ⇒
      cong Nat Nat (λ m : Nat ⇒ Nat.succ m) (add k 0) k ih)
    n

theorem add_succ (n m : Nat) : Eq Nat (add n (Nat.succ m)) (Nat.succ (add n m)) :=
  Nat.rec (λ x : Nat ⇒ Eq Nat (add x (Nat.succ m)) (Nat.succ (add x m)))
    refl
    (λ k : Nat ⇒ λ ih : Eq Nat (add k (Nat.succ m)) (Nat.succ (add k m)) ⇒
      cong Nat Nat (λ z : Nat ⇒ Nat.succ z) (add k (Nat.succ m))
        (Nat.succ (add k m)) ih)
    n

theorem add_comm (m n : Nat) : Eq Nat (add m n) (add n m) :=
  Nat.rec (λ x : Nat ⇒ Eq Nat (add x n) (add n x))
    (sym Nat (add n 0) n (add_zero n))
    (λ k : Nat ⇒ λ ih : Eq Nat (add k n) (add n k) ⇒
      trans Nat (add (Nat.succ k) n) (Nat.succ (add n k)) (add n (Nat.succ k))
        (cong Nat Nat (λ z : Nat ⇒ Nat.succ z) (add k n) (add n k) ih)
        (sym Nat (add n (Nat.succ k)) (Nat.succ (add n k)) (add_succ n k)))
    m
