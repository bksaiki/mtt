-- Binary sums: A + B is a tagged union, built with inl/inr and consumed
-- with case — the recursor: a motive saying what to conclude about the
-- scrutinee, then one branch per injection. Sums are positive: there is
-- no η, and a stuck sum is used only by case analysis.

axiom A : Type
axiom B : Type

-- the non-dependent eliminator as a plain definition (Lean's Sum.elim):
-- the explicit motive is written here once and for all
def elim (X Y Z : Type) (f : X → Z) (g : Y → Z) (s : X + Y) : Z :=
  case (λ x : X + Y ⇒ Z) s f g

def swap (X Y : Type) (s : X + Y) : Y + X :=
  elim X Y (Y + X) (λ x : X ⇒ (inr x : Y + X)) (λ y : Y ⇒ (inl y : Y + X)) s

-- ι-reduction: case picks the matching branch
axiom a : A
axiom b : B
#check_equal (swap A B (inl a)) (inr a)
#check_equal (swap A B (inr b)) (inl b)
-- double swap is the identity on injections...
#check_equal (swap B A (swap A B (inl a))) (inl a)
-- ...but NOT definitionally on stuck values (no η for sums); on a stuck
-- s, both sides freeze as distinct neutral cases

-- disjunction is a sum of propositions, and may be eliminated only into
-- Prop (the large-elimination restriction); this is f4 from logic.mtt,
-- by genuine case analysis
axiom p : Prop
axiom q : Prop
theorem or_swap (s : p + q) : q + p :=
  case (λ x : p + q ⇒ q + p) s (λ x : p ⇒ (inr x : q + p))
    (λ y : q ⇒ (inl y : q + p))

-- proofs of a disjunction are irrelevant: even different injections of
-- different proofs are definitionally equal
axiom hp : p
axiom hq : q
#check_equal (inl hp : p + q) (inr hq : p + q)
