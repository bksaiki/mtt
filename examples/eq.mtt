-- Building on the prelude's equality toolkit (symm/trans/cong/subst). This
-- file demonstrates what is special about the native Eq: rfl reifies the
-- checker's own conversion, and UIP holds for free.

axiom A : Type
axiom a : A
axiom b : A

-- rfl reifies conversion: it proves x = y precisely when x ≡ y, so β/δ/η
-- facts become first-class proofs
def idA (x : A) : A := x
theorem id_refl : Eq A (idA a) a := rfl
theorem beta_refl : Eq A ((λ x : A ⇒ x) a) a := rfl

-- the toolkit composes: symm (symm p) is p (both proofs of a = b — and equal
-- anyway by UIP)
axiom p : Eq A a b
#check_equal (symm (symm p)) p

-- ι: transport along rfl computes away. The endpoints are implicit, but a bare
-- rfl pins neither, so it is ascribed to fix them (Eq A a a).
axiom P : A → Type
axiom h : P a
#check_equal (subst P (rfl : Eq A a a) h) h

-- UIP for free: Eq lives in Prop, so proof irrelevance equates any two proofs
-- of the same equation — no axiom needed
axiom p2 : Eq A a b
#check_equal p p2

-- The toolkit is universe-polymorphic, so it works on equalities of
-- propositions too (A : Prop, level inferred as 0), not just data. There is no
-- cumulativity: the implicit {A : Sort u} in symm/subst is solved per use.
axiom R : Prop
axiom S : Prop
axiom rs : R = S
axiom r : R
-- symm on a Prop equality
#check symm rs
-- transport a proof across a Prop equality (the motive lands in Prop)
#check subst (λ z : Prop ⇒ z) rs r
-- and a Type-valued motive over a Prop point still transports
axiom T : Prop → Type
axiom t : T R
#check_equal (subst T rs t) (subst T rs t)
