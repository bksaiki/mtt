def Bool : Type 1 = (A : Type) -> A -> A -> A

def true : Bool = fun (A : Type) => fun (t : A) => fun (f : A) => t
def false : Bool = fun (A : Type) => fun (t : A) => fun (f : A) => f

def not : Bool -> Bool =
  fun (p : Bool) => fun (A : Type) => fun (t : A) => fun (f : A) =>
    p A (false A t f) (true A t f)

def and : Bool -> Bool -> Bool =
  fun (p : Bool) => fun (q : Bool) =>
    fun (A : Type) => fun (t : A) => fun (f : A) =>
      p A (q A t f) (p A t f)

def or : Bool -> Bool -> Bool =
  fun (p : Bool) => fun (q : Bool) =>
    fun (A : Type) => fun (t : A) => fun (f : A) =>
      p A (p A t f) (q A t f)

def xor : Bool -> Bool -> Bool =
  fun (p : Bool) => fun (q : Bool) =>
    fun (A : Type) => fun (t : A) => fun (f : A) =>
      p A ((not q) A t f) (q A t f)

def ife : Bool -> Bool -> Bool -> Bool =
  fun (p : Bool) => fun (a : Bool) => fun (b : Bool) =>
    fun (A : Type) => fun (t : A) => fun (f : A) =>
      p A (a A t f) (b A t f)

axiom B : Type
axiom T : B
axiom F : B

#check_equal (true B T F) T
#check_equal (false B T F) F

#check_equal ((not true) B T F) F
#check_equal ((not false) B T F) T

#check_equal ((and false false) B T F) F
#check_equal ((and false true) B T F) F
#check_equal ((and true false) B T F) F
#check_equal ((and true true) B T F) T

#check_equal ((or false false) B T F) F
#check_equal ((or false true) B T F) T
#check_equal ((or true false) B T F) T
#check_equal ((or true true) B T F) T

#check_equal ((xor false false) B T F) F
#check_equal ((xor false true) B T F) T
#check_equal ((xor true false) B T F) T
#check_equal ((xor true true) B T F) F

#check_equal ((ife true true false) B T F) T
#check_equal ((ife false true false) B T F) F
