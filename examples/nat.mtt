-- Building on the prelude (Nat, add/mul, the equality toolkit). This file
-- demonstrates what the prelude does NOT include: computation by recursion,
-- and constructor disjointness via large elimination.

-- ι-reduction: closed numerals compute
#check_equal (add 2 3) 5
#check_equal (mul 3 4) 12
#check_equal (pred 5) 4
#check_equal (mul 10 10) 100

-- a fresh inductive proof, building on the prelude's add_comm / add_succ:
-- n * 0 = 0, by induction on n (mul recurses on its first argument, and
-- add 0 _ reduces, so the step is just the induction hypothesis)
theorem mul_zero (n : Nat) : Eq Nat (mul n 0) 0 :=
  Nat.rec (λ m : Nat ⇒ Eq Nat (mul m 0) 0)
    refl
    (λ k : Nat ⇒ λ ih : Eq Nat (mul k 0) 0 ⇒ ih)
    n

-- constructor disjointness (no confusion): 0 ≠ succ n. A Nat-indexed type
-- that is Unit at 0 and Empty at succ — large elimination, Nat.rec into Type —
-- lets us transport () : code 0 along a bogus 0 = succ n into code (succ n) ≡
-- Empty. Uses the prelude's subst.
def code (n : Nat) : Type :=
  Nat.rec (λ x : Nat ⇒ Type) Unit (λ k : Nat ⇒ λ ih : Type ⇒ Empty) n

theorem zero_neq_succ (n : Nat) (p : Eq Nat 0 (Nat.succ n)) : Empty :=
  subst Nat code 0 (Nat.succ n) p ()
