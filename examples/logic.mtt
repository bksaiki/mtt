-- Propositional logic via Curry-Howard: propositions are types, proofs
-- are terms. Propositions live in Prop, the impredicative bottom sort:
-- a Π whose codomain is a proposition is itself a proposition, however
-- large the domain. That keeps every connective here at a single level.

-- A => (B => A)
theorem f1 (A B : Prop) (x : A) (y : B) : A := x

-- falsum: a proof of absurdity proves anything. Impredicativity is what
-- lets a quantification over all of Prop land back in Prop.
def absurdity := Π (p : Prop) ⇒ p
def negate (A : Prop) := A → absurdity

-- not A => (A => B)
theorem f2 (A B : Prop) (x : negate A) : A → B := λ y : A ⇒ x y B

-- A & B; product, Church-encoded
def conj (A B : Prop) := Π (C : Prop) ⇒ (A → B → C) → C

-- A => B => A & B
def conj_intro (A B : Prop) (x : A) (y : B) : conj A B :=
  λ (C : Prop) (k : A → B → C) ⇒ k x y

-- A & B => A
def conj_elim1 (A B : Prop) (x : conj A B) : A :=
  x A (λ (l : A) (m : B) ⇒ l)

-- A & B => B
def conj_elim2 (A B : Prop) (x : conj A B) : B :=
  x B (λ (l : A) (m : B) ⇒ m)

-- A & B => B & A
theorem f3 (A B : Prop) (x : conj A B) : conj B A :=
  conj_intro B A (conj_elim2 A B x) (conj_elim1 A B x)

-- A + B; sum, Church-encoded
def disj (A B : Prop) := Π (C : Prop) ⇒ (A → C) → (B → C) → C

-- A => A + B
def disj_intro1 (A B : Prop) (v : A) : disj A B :=
  λ (C : Prop) (x : A → C) (y : B → C) ⇒ x v

-- B => A + B
def disj_intro2 (A B : Prop) (v : B) : disj A B :=
  λ (C : Prop) (x : A → C) (y : B → C) ⇒ y v

-- A + B => B + A, by eliminating into [disj B A] — possible only because
-- [disj B A : Prop] fits the sum's own [C : Prop] quantifier. Predicatively
-- the conclusion lives one universe up and this proof is impossible.
theorem f4 (A B : Prop) (x : disj A B) : disj B A :=
  x (disj B A) (λ l : A ⇒ disj_intro2 B A l) (λ l : B ⇒ disj_intro1 B A l)

def not_a_or_b (A B : Prop) := negate (disj A B)
def not_a_and_not_b (A B : Prop) := conj (negate A) (negate B)

-- not (A + B) => (not A) & (not B)
theorem f5 (A B : Prop) (x : not_a_or_b A B) : not_a_and_not_b A B :=
  conj_intro
    (negate A)
    (negate B)
    (λ y : A ⇒ x (disj_intro1 A B y))
    (λ y : B ⇒ x (disj_intro2 A B y))

-- universal quantification over data is just the dependent function type;
-- by impredicativity it is again a Prop
def my_forall (A : Type) (P : A → Prop) := Π (x : A) ⇒ P x

-- existential quantification, Church-encoded sigma
def my_exists (A : Type) (P : A → Prop) :=
  Π (C : Prop) ⇒ (Π (x : A) (y : P x) ⇒ C) → C

-- x => P(x) => exists x, P(x)
def exists_intro (A : Type) (P : A → Prop) (x : A) (y : P x) : my_exists A P :=
  λ (C : Prop) (f : Π (x : A) (y : P x) ⇒ C) ⇒ f x y

def not_exists (A : Type) (P : A → Prop) := negate (my_exists A P)
def forall_not (A : Type) (P : A → Prop) := my_forall A (λ y : A ⇒ negate (P y))

-- not (exists x, P(x)) => forall y, not P(y)
theorem f6 (A : Type) (P : A → Prop) (x : not_exists A P) : forall_not A P :=
  λ (y : A) (z : P y) ⇒ x (exists_intro A P y z)

-- proof irrelevance: any two proofs of the same proposition are
-- definitionally equal — even these two opaque theorems, whose proofs
-- were checked and then forgotten
theorem k1 (A B : Prop) (x : A) (y : B) : A := x
theorem k2 (A B : Prop) (x : A) (y : B) : B → A := λ z : B ⇒ x
#check_equal k1 f1
